# 复制为 .env 并按需修改

# 评测 Key：平台调用我方接口时携带；留空 = 本地开发不鉴权
AML_API_KEY=change-me

# 阿里云 DashScope（text-embedding-v4，OpenAI 兼容接口）
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
# 0 = 用模型默认维度；text-embedding-v4 支持 dimensions 参数（如 1024）
EMBED_DIM=1024
EMBED_BATCH=10
EMBED_TIMEOUT=30

# 存储
DB_PATH=data/memories.db

# 可选重排（v1 默认关闭）
ENABLE_RERANK=0

# 服务
HOST=0.0.0.0
PORT=8080
# 内存中最多缓存的用户索引数（LRU 淘汰，超出从 SQLite 重载，控制内存占用）
MAX_CACHED_USERS=32
